{
  "manifest_version": 3,
  "name": "ReddMark",
  "version": "1.1.0",
  "description": "Download any Reddit post and its comments as a Markdown file.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://old.reddit.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/r/*/comments/*",
        "https://old.reddit.com/r/*/comments/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
